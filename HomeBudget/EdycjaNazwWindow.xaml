<Window x:Class="HomeBudget.EdycjaNazwyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edycja gospodarstwa" Height="310" Width="320"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Top">
            <TextBlock Text="Nazwa gospodarstwa:" Margin="0,0,0,5"/>
            <TextBox x:Name="NowaNazwaBox" Height="28" VerticalContentAlignment="Center" Margin="0,0,0,15"/>

            <TextBlock Text="Zmiana hasła (opcjonalnie):" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBlock Text="Obecne hasło:" Margin="0,0,0,3"/>
            <PasswordBox x:Name="StareHasloBox" Height="28" VerticalContentAlignment="Center" Margin="0,0,0,10"/>

            <TextBlock Text="Nowe hasło:" Margin="0,0,0,3"/>
            <PasswordBox x:Name="NoweHasloBox" Height="28" VerticalContentAlignment="Center"/>
        </StackPanel>

        <Button Content="Zapisz" Click="Zapisz_Click" Width="80" Height="30"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
    </Grid>
</Window>