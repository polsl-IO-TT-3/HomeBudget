<Page x:Class="HomeBudget.TworzenieGospodarstwaPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="tworzenie gospodarstwa">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="280">
            <TextBlock Text="Nazwa gospodarstwa" Margin="0,0,0,5"/>
            <TextBox x:Name="NazwaBox" Height="30" VerticalContentAlignment="Center" Margin="0,0,0,15"/>

            <TextBlock Text="Hasło" Margin="0,0,0,5"/>
            <PasswordBox x:Name="HasloBox" Height="30" VerticalContentAlignment="Center"/>
        </StackPanel>

        <Button Content="Cofnij" Click="Cofnij_Click" Width="90" Height="32"
                HorizontalAlignment="Left" VerticalAlignment="Bottom"/>

        <Button Content="Stwórz" Click="Stworz_Click" Width="90" Height="32"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" IsDefault="True"/>
    </Grid>
</Page>
