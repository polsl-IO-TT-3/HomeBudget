<Window x:Class="HomeBudget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Height="500" Width="760"
        MinHeight="420" MinWidth="560"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Styl kafelka gospodarstwa (jak na szkicu) -->
        <Style x:Key="WorkspaceCardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#1E293B"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Height" Value="68"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="14,8">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="#EFF6FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="#DBEAFE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Styl przycisku "+ Dodaj gospodarstwo" -->
        <Style x:Key="AddWorkspaceButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="AddBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="14,6">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="AddBorder" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="AddBorder" Property="BorderBrush" Value="#475569"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- ================================================================ -->
        <!-- WIDOK 1: WYBÓR GOSPODARSTWA + DODAJ GOSPODARSTWO                 -->
        <!-- ================================================================ -->
        <Grid Visibility="{Binding IsSelectionVisible, Converter={StaticResource BoolToVis}}"
              Margin="40">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Width="360"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <ItemsControl ItemsSource="{Binding Workspaces}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource WorkspaceCardButtonStyle}"
                                        Click="WorkspaceCard_Click"
                                        Tag="{Binding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Kółko / awatar jak na szkicu -->
                                        <Border Width="44" Height="44"
                                                CornerRadius="22"
                                                BorderBrush="#1E293B"
                                                BorderThickness="1.5"
                                                Background="#F8FAFC"
                                                Margin="0,0,16,0">
                                            <TextBlock Text="{Binding Initials}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontWeight="SemiBold"
                                                       FontSize="15"
                                                       Foreground="#1E293B"/>
                                        </Border>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Name}"
                                                   VerticalAlignment="Center"
                                                   FontSize="16"
                                                   Foreground="#0F172A"/>

                                        <TextBlock Grid.Column="2"
                                                   Text="🔒"
                                                   VerticalAlignment="Center"
                                                   FontSize="13"
                                                   Foreground="#64748B"
                                                   Visibility="{Binding IsProtected, Converter={StaticResource BoolToVis}}"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Style="{StaticResource AddWorkspaceButtonStyle}"
                            Command="{Binding ShowCreateWorkspaceCommand}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="+"
                                       FontSize="24"
                                       FontWeight="Light"
                                       VerticalAlignment="Center"
                                       Margin="6,-3,16,0"
                                       Foreground="#1E293B"/>
                            <TextBlock Text="Dodaj gospodarstwo"
                                       FontSize="15"
                                       VerticalAlignment="Center"
                                       Foreground="#334155"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>

            <TextBlock Grid.Row="1"
                       Text="Dane testowe: hasło do Gospodarstwo 1 oraz Gospodarstwo 2 to 1234"
                       HorizontalAlignment="Center"
                       FontSize="11.5"
                       Foreground="#64748B"
                       Margin="0,14,0,0"/>
        </Grid>

        <!-- ================================================================ -->
        <!-- WIDOK 2: TWORZENIE GOSPODARSTWA (NA TEJ SAMEJ STRONIE)           -->
        <!-- ================================================================ -->
        <Grid Visibility="{Binding IsCreateVisible, Converter={StaticResource BoolToVis}}"
              Margin="40">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Width="360"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock Text="Nazwa gospodarstwa"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#1E293B"
                           Margin="0,0,0,6"/>
                <TextBox x:Name="NewWorkspaceNameInput"
                         Text="{Binding NewWorkspaceName, UpdateSourceTrigger=PropertyChanged}"
                         Height="34"
                         VerticalContentAlignment="Center"
                         Padding="8,0"
                         BorderBrush="#1E293B"
                         BorderThickness="1.3"
                         Margin="0,0,0,18"/>

                <TextBlock Text="Hasło (opcjonalne)"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#1E293B"
                           Margin="0,0,0,6"/>
                <PasswordBox x:Name="NewWorkspacePasswordInput"
                             Height="34"
                             VerticalContentAlignment="Center"
                             Padding="8,0"
                             BorderBrush="#1E293B"
                             BorderThickness="1.3"
                             Margin="0,0,0,10"/>

                <TextBlock Text="{Binding CreateErrorMessage}"
                           Foreground="#DC2626"
                           FontSize="12.5"
                           TextWrapping="Wrap"
                           MinHeight="20"/>
            </StackPanel>

            <Grid Grid.Row="1">
                <Button Content="Wróć"
                        Width="100"
                        Height="34"
                        HorizontalAlignment="Left"
                        Command="{Binding CancelCreateWorkspaceCommand}"
                        Click="CancelCreateButton_Click"
                        Background="White"
                        BorderBrush="#64748B"
                        BorderThickness="1.2"/>

                <Button Content="Stwórz"
                        Width="110"
                        Height="34"
                        HorizontalAlignment="Right"
                        Click="CreateWorkspaceButton_Click"
                        Background="White"
                        BorderBrush="#1E293B"
                        BorderThickness="1.4"
                        FontWeight="SemiBold"/>
            </Grid>
        </Grid>

        <!-- ================================================================ -->
        <!-- WIDOK 3: EKRAN PO ZALOGOWANIU (MIEJSCE NA DALSZĄ ROZBUDOWĘ)      -->
        <!-- ================================================================ -->
        <Grid Visibility="{Binding IsDashboardVisible, Converter={StaticResource BoolToVis}}"
              Margin="40">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Zalogowano pomyślnie!"
                           FontSize="22"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Foreground="#15803D"
                           Margin="0,0,0,8"/>

                <TextBlock HorizontalAlignment="Center"
                           FontSize="16"
                           Foreground="#334155"
                           Margin="0,0,0,24">
                    <Run Text="Aktywne gospodarstwo: "/>
                    <Run Text="{Binding LoggedInWorkspace.Name}" FontWeight="SemiBold"/>
                </TextBlock>

                <Button Content="Wyloguj / Zmień gospodarstwo"
                        Command="{Binding LogoutCommand}"
                        Padding="18,8"
                        HorizontalAlignment="Center"
                        Background="White"
                        BorderBrush="#1E293B"
                        BorderThickness="1.2"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
