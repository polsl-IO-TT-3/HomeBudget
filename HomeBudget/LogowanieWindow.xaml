<Window x:Class="HomeBudget.LogowanieWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Logowanie" Height="220" Width="320" 
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Wpisz hasło" HorizontalAlignment="Center" FontSize="14" Margin="0,0,0,10"/>
            <PasswordBox x:Name="HasloBox" Height="30" VerticalContentAlignment="Center" FontSize="14"/>
        </StackPanel>

        <Button Content="loguj" Click="Loguj_Click" Width="80" Height="30" 
                HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
    </Grid>
</Window>