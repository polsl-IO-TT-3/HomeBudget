<UserControl x:Class="HomeBudget.Components.DashboardSectionCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource DashboardCardStyle}">
        <DockPanel>
            <!-- Górny pasek z tytułem -->
            <Border DockPanel.Dock="Top"
                    Background="{Binding HeaderBackground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Padding="8,7">
                <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="{Binding HeaderForeground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           HorizontalAlignment="Center"/>
            </Border>

            <!-- Dolny pasek SUMA (ukrywa się automatycznie, gdy TotalText jest pusty) -->
            <Border DockPanel.Dock="Bottom" Background="#E2E8F0" Padding="10,6">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding TotalText, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding TotalText, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <TextBlock Text="SUMA" FontWeight="Bold" FontSize="11.5" Foreground="#1E293B"/>
                    <TextBlock Text="{Binding TotalText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   FontWeight="Bold" FontSize="11.5" HorizontalAlignment="Right" Foreground="#1E293B"/>
                </DockPanel>
            </Border>

            <!-- Środek karty (tabela, wykres itp.) -->
            <ContentPresenter Content="{Binding CardContent, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
        </DockPanel>
    </Border>
</UserControl>