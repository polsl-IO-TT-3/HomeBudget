<Page x:Class="HomeBudget.TworzenieGospodarstwaPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Tworzenie gospodarstwa"
      Background="#F8FAFC">
    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Width="360"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <TextBlock Text="Nazwa gospodarstwa"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="#1E293B"
                       Margin="0,0,0,6"/>
            <TextBox x:Name="NazwaBox"
                     Height="34"
                     VerticalContentAlignment="Center"
                     Padding="8,0"
                     BorderBrush="#1E293B"
                     BorderThickness="1.3"
                     ToolTip="Wpisz nazwę gospodarstwa"
                     Margin="0,0,0,18"/>

            <TextBlock Text="Hasło (opcjonalne)"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="#1E293B"
                       Margin="0,0,0,6"/>
            <PasswordBox x:Name="HasloBox"
                         Height="34"
                         VerticalContentAlignment="Center"
                         Padding="8,0"
                         BorderBrush="#1E293B"
                         BorderThickness="1.3"
                         ToolTip="Wpisz haslo"
                         Margin="0,0,0,10"/>

            <TextBlock x:Name="ErrorText"
                       Foreground="#DC2626"
                       FontSize="12.5"
                       TextWrapping="Wrap"
                       MinHeight="20"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Button Content="Wróć"
        Width="100"
        HorizontalAlignment="Left"
        Click="Cofnij_Click"
        Style="{StaticResource SecondaryButtonStyle}"
        ToolTip="Wróć do listy gospodarstw"/>

            <Button Content="Stwórz"
        Width="110"
        HorizontalAlignment="Right"
        IsDefault="True"
        Click="Stworz_Click"
        Style="{StaticResource PrimaryButtonStyle}"
        ToolTip="Zapisz i utwórz nowe gospodarstwo"/>
        </Grid>
    </Grid>
</Page>
