<Page x:Class="HomeBudget.ListaGospodarstwPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:components="clr-namespace:HomeBudget.Components"
      Title="Budżet domowy"
      Background="#F8FAFC">
    <Page.Resources>
        <!-- Styl przycisku "+ Dodaj gospodarstwo" -->
        <Style x:Key="AddWorkspaceButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="AddBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="14,6">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="AddBorder" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="AddBorder" Property="BorderBrush" Value="#475569"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Width="448"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <ItemsControl x:Name="ListaGospodarstw">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <components:GospodarstwoCard/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Style="{StaticResource AddWorkspaceButtonStyle}"
                        Click="DodajGospodarstwo_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="+"
                                   FontSize="24"
                                   FontWeight="Light"
                                   VerticalAlignment="Center"
                                   Margin="6,-3,16,0"
                                   Foreground="#1E293B"/>
                        <TextBlock Text="Dodaj gospodarstwo"
                                   FontSize="15"
                                   VerticalAlignment="Center"
                                   Foreground="#334155"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="1"
                   Text="Program stworzony na potrzeby projektu Inżynieria Oprogramowania"
                   HorizontalAlignment="Center"
                   FontSize="11.5"
                   Foreground="#64748B"
                   Margin="0,14,0,0"/>
    </Grid>
</Page>