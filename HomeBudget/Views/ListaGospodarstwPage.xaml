<Page x:Class="HomeBudget.ListaGospodarstwPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:components="clr-namespace:HomeBudget.Components"
      Title="Budżet domowy"
      Background="#F8FAFC">
    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Width="448"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <ItemsControl x:Name="ListaGospodarstw">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <components:GospodarstwoCard/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Style="{StaticResource SecondaryButtonStyle}"
                        Height="48"
                        HorizontalContentAlignment="Left"
                        Click="DodajGospodarstwo_Click"
                        ToolTip="Utwórz nowe gospodarstwo">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="+"
                                   FontSize="24"
                                   FontWeight="Light"
                                   VerticalAlignment="Center"
                                   Margin="6,-3,16,0"
                                   Foreground="#1E293B"/>
                        <TextBlock Text="Dodaj gospodarstwo"
                                   FontSize="15"
                                   VerticalAlignment="Center"
                                   Foreground="#334155"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </ScrollViewer>
        <TextBlock Grid.Row="1"
           Text="Program stworzony na potrzeby projektu IO"
           HorizontalAlignment="Center"
           VerticalAlignment="Bottom"
           FontSize="11.5"
           Foreground="#64748B"
           Margin="0,14,0,0"/>

    </Grid>
</Page>