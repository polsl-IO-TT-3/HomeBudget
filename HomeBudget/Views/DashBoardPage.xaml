<Page x:Class="HomeBudget.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Dashboard"
      Background="#F8FAFC">
    <Grid Margin="40">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="NazwaGospodarstwaText"
                       FontSize="22"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Foreground="#1E293B"
                       Margin="0,0,0,8"/>

            <TextBlock Text="Panel główny (Dashboard)"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       Foreground="#64748B"
                       Margin="0,0,0,28"/>

            <Button Content="Wyłącz aplikację"
                    Click="WylaczAplikacje_Click"
                    Width="180"
                    Height="38"
                    Background="White"
                    Foreground="#DC2626"
                    BorderBrush="#DC2626"
                    BorderThickness="1.3"
                    FontWeight="SemiBold"
                    Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Page>