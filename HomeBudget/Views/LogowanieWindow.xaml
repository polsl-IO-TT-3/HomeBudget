<Window x:Class="HomeBudget.LogowanieWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Logowanie"
        Height="230" Width="340"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="White">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="WorkspaceTitleText"
                   Grid.Row="0"
                   HorizontalAlignment="Center"
                   FontSize="12"
                   Foreground="#64748B"
                   Margin="0,0,0,6"/>

        <TextBlock Grid.Row="1"
                   Text="Wpisz hasło"
                   FontSize="15"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center"
                   Foreground="#1E293B"
                   Margin="0,0,0,10"/>

        <PasswordBox x:Name="HasloBox"
                     Grid.Row="2"
                     Height="32"
                     VerticalContentAlignment="Center"
                     Padding="8,0"
                     BorderBrush="#334155"
                     BorderThickness="1.2"/>

        <TextBlock x:Name="ErrorText"
                   Grid.Row="3"
                   Foreground="#DC2626"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="0,8,0,0"/>

        <Button x:Name="ConfirmButton"
                Grid.Row="4"
                Content="Loguj"
                Width="90"
                Height="30"
                HorizontalAlignment="Right"
                IsDefault="True"
                Click="Loguj_Click"
                Background="White"
                BorderBrush="#334155"
                BorderThickness="1.2"
                FontWeight="SemiBold"
                Cursor="Hand"/>
    </Grid>
</Window>
