<Window x:Class="HomeBudget.UsunGospodarstwoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Usuwanie gospodarstwa"
        Height="250" Width="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="White">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Usunąć gospodarstwo?"
                   FontSize="16"
                   FontWeight="Bold"
                   Foreground="#DC2626"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,6"/>

        <TextBlock x:Name="OpisText"
                   Grid.Row="1"
                   FontSize="13"
                   Foreground="#334155"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Margin="0,0,0,14"/>

        <StackPanel x:Name="HasloPanel" Grid.Row="2">
            <TextBlock Text="Potwierdź hasłem:"
                       FontSize="12"
                       Foreground="#64748B"
                       Margin="0,0,0,4"/>
            <PasswordBox x:Name="HasloBox"
                         Height="32"
                         VerticalContentAlignment="Center"
                         Padding="8,0"
                         BorderBrush="#334155"
                         BorderThickness="1.2"/>
        </StackPanel>

        <TextBlock x:Name="ErrorText"
                   Grid.Row="3"
                   Foreground="#DC2626"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="0,8,0,0"/>

        <Grid Grid.Row="4">
            <Button Content="Anuluj"
        Width="96"
        HorizontalAlignment="Left"
        IsCancel="True"
        Style="{StaticResource SecondaryButtonStyle}"
        ToolTip="Anuluj usuwanie"/>

            <Button Content="Usuń"
        Width="96"
        HorizontalAlignment="Right"
        IsDefault="True"
        Click="Usun_Click"
        Style="{StaticResource DangerButtonStyle}"
        ToolTip="Trwale usuń gospodarstwo"/>
        </Grid>
    </Grid>
</Window>