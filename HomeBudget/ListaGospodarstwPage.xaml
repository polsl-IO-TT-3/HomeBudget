<Page x:Class="HomeBudget.ListaGospodarstwPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="HomeBudget">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="330" Margin="0,20">
                <ItemsControl x:Name="ListaGospodarstw">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="45"/>
                                    <ColumnDefinition Width="45"/>
                                </Grid.ColumnDefinitions>

                                <!-- Główny przycisk gospodarstwa -->
                                <Button Grid.Column="0" Click="Gospodarstwo_Click" Tag="{Binding}" 
                                        Height="55" Background="White" BorderBrush="Black" BorderThickness="1.5">
                                    <StackPanel Orientation="Horizontal" Width="210" VerticalAlignment="Center">
                                        <Grid Width="35" Height="35" Margin="5,0,12,0">
                                            <Ellipse Fill="#E3F2FD" Stroke="Black" StrokeThickness="1.5"/>
                                            <TextBlock Text="{Binding Inicjal}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       FontSize="16" FontWeight="Bold" Foreground="#1565C0"/>
                                        </Grid>
                                        <TextBlock Text="{Binding Nazwa}" VerticalAlignment="Center" FontSize="15" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Button>

                                <!-- Przycisk edycji nazwy i hasła -->
                                <Button Grid.Column="1" Content="✎" Click="EdytujNazwe_Click" Tag="{Binding}"
                                        Height="55" Margin="5,0,0,0" Background="White" BorderBrush="Gray" BorderThickness="1"
                                        FontSize="18" ToolTip="Edytuj nazwę lub hasło"/>

                                <!-- Przycisk usuwania -->
                                <Button Grid.Column="2" Content="✕" Click="UsunGospodarstwo_Click" Tag="{Binding}"
                                        Height="55" Margin="5,0,0,0" Background="White" BorderBrush="Gray" BorderThickness="1"
                                        FontSize="16" Foreground="Crimson" FontWeight="Bold" ToolTip="Usuń gospodarstwo"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Przycisk dodawania -->
                <Button Click="DodajGospodarstwo_Click" Height="45" Background="White" BorderBrush="Gray" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Width="300" VerticalAlignment="Center">
                        <TextBlock Text="+" FontSize="24" Margin="12,0,20,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Dodaj gospodarstwo" VerticalAlignment="Center" FontSize="15"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
